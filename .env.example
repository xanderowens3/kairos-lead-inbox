# Copy to .env for local dev:  cp .env.example .env
# On Railway, set these as service Variables instead (no .env file needed).

# Trigify API key (x-api-key). Required.
TRIGIFY_API_KEY=your_trigify_api_key

# Anthropic API key. Required for lead analysis/qualification.
ANTHROPIC_API_KEY=your_anthropic_api_key

# PORT is provided automatically by Railway. Only set locally to override 4173.
# PORT=4173
